---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import NoteList from '../../components/NoteList.astro';
const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime() || a.data.order - b.data.order);
---
<Base title="Notes" active="Notes">
  <section class="shell page-intro"><span class="eyebrow">Observations from the work</span><h1>Field notes<span>.</span></h1><p>On building useful systems, working with AI, and making progress visible. Small pieces of thinking, with room to change my mind.</p></section>
  <section class="shell notes-index" aria-label="All field notes"><NoteList notes={notes} /></section>
</Base>
