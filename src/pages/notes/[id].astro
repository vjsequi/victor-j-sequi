---
import { getCollection, render } from 'astro:content';
import { ArrowLeft, ArrowUpRight } from '@lucide/astro';
import Base from '../../layouts/Base.astro';
import { url, displayDate, profile } from '../../lib/site';
export async function getStaticPaths() {
  return (await getCollection('notes', ({ data }) => !data.draft)).map(note => ({ params: { id: note.id }, props: { note } }));
}
const { note } = Astro.props;
const { Content } = await render(note);
---
<Base title={note.data.title} description={note.data.summary} active="Notes">
  <article class="shell article">
    <a class="back-link" href={url('notes/')}><ArrowLeft size={16} aria-hidden="true" /> All notes</a>
    <header class="article-header"><span class="eyebrow">{note.data.category} / <time datetime={note.data.date.toISOString()}>{displayDate(note.data.date)}</time></span><h1>{note.data.title}<span>.</span></h1><p class="article-deck">{note.data.summary}</p></header>
    <div class="prose"><Content /></div>
    <div class="article-end"><p>Have a different perspective?</p><a class="text-link" href={profile.linkedin}>Continue the conversation on LinkedIn <ArrowUpRight size={17} aria-hidden="true" /></a></div>
  </article>
</Base>
